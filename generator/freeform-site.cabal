cabal-version:      3.0
name:               freeform-site
version:            0.1.0.0
build-type:         Simple

library
  exposed-modules:
      Factory.Domain
    , Factory.Geometry
    , Factory.Interpreter
    , Factory.Evaluation
    , Factory.Pdf
    , Factory.Pipeline
    , Factory.Site
    , Factory.Vectorize
  hs-source-dirs:   src
  default-language: GHC2021
  default-extensions:
      DerivingStrategies
    , FlexibleInstances
    , GeneralizedNewtypeDeriving
    , TupleSections
  ghc-options:      -Wall -Wcompat -Werror
  build-depends:
      aeson
    , base >=4.18 && <4.19
    , bytestring
    , containers
    , cryptohash-sha256
    , directory
    , filepath
    , JuicyPixels
    , io-streams
    , mtl
    , network-uri
    , pdf-toolbox-content ==0.1.2
    , pdf-toolbox-core ==0.1.3
    , pdf-toolbox-document ==0.1.4
    , process
    , primitive
    , scientific
    , text
    , unordered-containers
    , vector

executable freeform-site
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: GHC2021
  ghc-options:      -Wall -Wcompat -Werror
  build-depends:
      base >=4.18 && <4.19
    , freeform-site

test-suite freeform-site-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  default-language: GHC2021
  ghc-options:      -Wall -Wcompat -Werror
  build-depends:
      aeson
    , base >=4.18 && <4.19
    , bytestring
    , containers
    , freeform-site
    , JuicyPixels
    , pdf-toolbox-content ==0.1.2
    , pdf-toolbox-core ==0.1.3
    , scientific
    , tasty
    , tasty-hunit
    , text
    , vector
